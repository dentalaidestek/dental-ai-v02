{
  "name": "dental-ai-mobile",
  "version": "0.2.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "test": "npm run typecheck && npm run test:session && npm run test:realtime && npm run test:beta",
    "typecheck": "tsc --noEmit",
    "test:session": "node --test tests/session.cjs tests/sessionHealth.cjs tests/sessionForeground.cjs",
    "test:realtime": "node --test tests/realtime.cjs tests/analysisRefresh.cjs tests/analysisRecovery.cjs tests/pagedRecords.cjs",
    "test:beta": "node --test tests/social.cjs tests/findings.cjs tests/socialScreens.cjs tests/sessionExpiry.cjs tests/voiceApi.cjs tests/consultations.cjs tests/analysisApi.cjs tests/patientApi.cjs tests/mobileChat.cjs tests/consultationRequest.cjs",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@react-navigation/bottom-tabs": "^7.4.5",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "expo": "~54.0.0",
    "expo-crypto": "~15.0.9",
    "expo-image-picker": "~17.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.12",
    "typescript": "~5.9.2"
  }
}
