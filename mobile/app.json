{
  "expo": {
    "name": "DENTAL AI",
    "slug": "dental-ai",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "dentalai",
    "userInterfaceStyle": "light",
    "android": {
      "package": "tr.dentalai.app",
      "versionCode": 6,
      "allowBackup": false,
      "usesCleartextTraffic": false,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Hasta görüntülerini ve paylaşım fotoğraflarını seçmek için fotoğraf erişimi kullanılır.",
          "cameraPermission": "Hasta görüntüsünü çekmek için kamera erişimi kullanılır.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Dental AI sesli muayenede yalnızca izninizle mikrofonu kullanır.",
          "recordAudioAndroid": true
        }
      ],
      "expo-notifications"
    ],
    "ios": {
      "bundleIdentifier": "tr.dentalai.app",
      "buildNumber": "2",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": true
      }
    },
    "extra": {
      "eas": {
        "projectId": "f19bc199-7b6a-46e5-affd-13154392ae8b"
      }
    }
  }
}